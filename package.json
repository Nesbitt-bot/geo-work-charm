{
  "name": "geo-work-charm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@turf/destination": "^7.2.0",
    "@turf/distance": "^7.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
